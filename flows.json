        "func": "var id=flow.get(\"lastId\") || 0;\nvar text = msg.payload;\nvar time = new Date();\n\n++id;\nmsg.payload={\ncommand:\"addRow\",\n    arguments: [\n    [\n        {\n        \"id\":id,\n        \"timestamp\":time,\n        \"text\":text+' '\n        }\n    ],\n    true\n],\nreturnPromise: true\n}\nflow.set(\"lastId\",id);\n\nreturn msg;",
